# OmniCell-AI Phase 3 — Environment Configuration
# Copy to .env and fill in your values. Never commit the real .env to git.

# ── LLM Provider (xAI Grok) ──────────────────────────────────────────────────
# Grok is OpenAI API-compatible — only base_url + key differ.
# Get your key at: https://console.x.ai/
XAI_API_KEY=your_xai_or_groq_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=groq:openai/gpt-oss-120b

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=BioprocessSecurePassword2026

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=omnicell-telemetry
KAFKA_GROUP_ID=omnicell-swarm-watchdog
KAFKA_POLL_MS=1000

# ── Swarm Thresholds ──────────────────────────────────────────────────────────
LACTATE_THRESHOLD_MMOL=2.0  
